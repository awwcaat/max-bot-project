# Dockerfile — инструкция, как собрать «коробку» (образ) с ботом.
# В коробке уже есть Python и все библиотеки, на компьютере ничего ставить не нужно.

# Готовая коробка с Python 3.12
FROM python:3.12-slim

# Рабочая папка внутри коробки
WORKDIR /app

# Сначала библиотеки (отдельным шагом: при изменении кода они не скачиваются заново)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Код бота
COPY bot.py logic.py web.py ./

# Python сразу печатает сообщения в консоль, без задержки
ENV PYTHONUNBUFFERED=1

# Веб-кабинет куратора работает на порту 8080
EXPOSE 8080

# Что запускать: бота (он сам запускает и веб-кабинет)
CMD ["python", "bot.py"]
